# /etc/gulbot/gulbot.env -- THE production settings (docs/DEPLOY.md, step 4).
# Owner root, group gulbot, mode 0640. Every gulbot service reads it through
# systemd's EnvironmentFile, and docker compose reads it with --env-file.
# Never copy it into /opt/gulbot as .env, and never commit a filled-in copy.

# Arms the production guard. Every process refuses to start without the
# required values below, and refuses the dev password.
ENVIRONMENT=production

# The pilot shop's bot (shops that onboarded through the platform bot use
# their own stored token instead).
BOT_TOKEN=
# The PLATFORM bot: shop-owner onboarding and the admin login link. A bot of
# its own, never a shop's.
PLATFORM_BOT_TOKEN=
# Who may log into /admin: Telegram user ids, comma-separated. Production
# refuses to start if this is empty or not a list of ids.
PLATFORM_ADMIN_TELEGRAM_IDS=
# Fernet key for stored shop tokens. Generate ONCE:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up with the database credentials, never inside the database.
SHOP_TOKEN_ENCRYPTION_KEY=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=gulbot_prod
# Long and random; anything but "gulbot".
POSTGRES_PASSWORD=
POSTGRES_DB=gulbot_prod

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB_BROKER=0
REDIS_DB_RESULTS=1
REDIS_DB_FSM=2

# The pages' and the panel's address: https, an origin, no trailing slash.
PUBLIC_BASE_URL=https://pages.example.uz
WEB_HOST=127.0.0.1
WEB_PORT=8088
# Only because Caddy sets X-Forwarded-For in front of the page server.
WEB_TRUST_PROXY=true

TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO

# The product's name in every bot text, the admin panel and the pages. Not
# decided yet: this is the working name; change it here once it is. No < > & { },
# max 40 chars.
BRAND_NAME=Gulbot
