# Copy to .env and fill in. .env is gitignored.

# --- Database -------------------------------------------------------------
# Host port 5433 -> container 5432. Never 5432: that port belongs to other
# projects on this machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=gulbot
POSTGRES_PASSWORD=gulbot
POSTGRES_DB=gulbot
# Tests run against their own database on the same server.
POSTGRES_TEST_DB=gulbot_test

# --- Redis ----------------------------------------------------------------
# Host port 6380 -> container 6379. Separate logical DBs so a Celery purge
# can never wipe live FSM state (and vice versa).
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB_BROKER=0
REDIS_DB_RESULTS=1
REDIS_DB_FSM=2
REDIS_DB_TEST=15

# --- Telegram -------------------------------------------------------------
# Dev bot token from @BotFather. NEVER the production token.
# Since per-shop tokens: used ONLY by the single shop that existed before them
# (shops.uses_process_bot_token), and logged every time it is. Every other shop
# stores its own token, encrypted, in shops.bot_token_encrypted.
BOT_TOKEN=

# Fernet key(s) that encrypt each shop's bot token at rest. Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several to ROTATE: the first encrypts, all of them decrypt.
# Lose it and every stored shop token is unreadable -- back it up with the DB
# credentials, never in the database itself.
SHOP_TOKEN_ENCRYPTION_KEY=

# The PLATFORM bot: where shop OWNERS onboard a new shop (/start). A separate
# bot from @BotFather -- never a shop's own bot, never BOT_TOKEN's. Leave empty
# to run without onboarding. Requires SHOP_TOKEN_ENCRYPTION_KEY.
PLATFORM_BOT_TOKEN=
# CP18: Telegram ids allowed into /admin, comma-separated. Required in production.
PLATFORM_ADMIN_TELEGRAM_IDS=

# --- Public pages (Ha/Yo'q, taklifnoma) -----------------------------------
# An ORIGIN, no path. Locally the default works as is. In production it must
# be https on a real domain, or the bot keeps the feature switched off.
PUBLIC_BASE_URL=http://127.0.0.1:8088
WEB_HOST=127.0.0.1
WEB_PORT=8088
# true only behind a reverse proxy that sets X-Forwarded-For.
WEB_TRUST_PROXY=false

# --- Runtime --------------------------------------------------------------
TIMEZONE=Asia/Tashkent
ENVIRONMENT=local
LOG_LEVEL=INFO
# The product's name wherever a person reads it (bot texts, admin panel, pages).
# Undecided; the default is the working name. No < > & { }, at most 40 chars.
# BRAND_NAME=Gulbot
