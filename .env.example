# Copy to .env and fill in. .env is gitignored.

# --- Database -------------------------------------------------------------
# Host port 5433 -> container 5432. Never 5432: that port belongs to other
# projects on this machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=gulbot
POSTGRES_PASSWORD=gulbot
POSTGRES_DB=gulbot
# Tests run against their own database on the same server.
POSTGRES_TEST_DB=gulbot_test
# Per long-lived bot/web process. Each prefork worker task instead owns one
# connection by default, with no overflow. Multiply by process concurrency.
POSTGRES_POOL_SIZE=5
POSTGRES_POOL_OVERFLOW=10
POSTGRES_TASK_POOL_SIZE=1

# --- Redis ----------------------------------------------------------------
# Host port 6380 -> container 6379. Separate logical DBs so a Celery purge
# can never wipe live FSM state (and vice versa).
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB_BROKER=0
REDIS_DB_RESULTS=1
REDIS_DB_FSM=2
REDIS_DB_TEST=15

# --- Telegram -------------------------------------------------------------
# Dev bot token from @BotFather. NEVER the production token.
# Since per-shop tokens: used ONLY by the single shop that existed before them
# (shops.uses_process_bot_token), and logged every time it is. Every other shop
# stores its own token, encrypted, in shops.bot_token_encrypted.
BOT_TOKEN=

# Fernet key(s) that encrypt each shop's bot token at rest. Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several to ROTATE: the first encrypts, all of them decrypt.
# Lose it and every stored shop token is unreadable -- back it up with the DB
# credentials, never in the database itself.
SHOP_TOKEN_ENCRYPTION_KEY=

# The PLATFORM bot: where shop OWNERS onboard a new shop (/start). A separate
# bot from @BotFather -- never a shop's own bot, never BOT_TOKEN's. Leave empty
# to run without onboarding. Requires SHOP_TOKEN_ENCRYPTION_KEY.
PLATFORM_BOT_TOKEN=
# CP18: Telegram ids allowed into /admin, comma-separated. Required in production.
PLATFORM_ADMIN_TELEGRAM_IDS=

# --- Public pages (Ha/Yo'q, taklifnoma) -----------------------------------
# An ORIGIN, no path. Locally the default works as is. In production it must
# be https on a real domain, or the bot keeps the feature switched off.
PUBLIC_BASE_URL=http://127.0.0.1:8088
WEB_HOST=127.0.0.1
WEB_PORT=8088
# true only behind a reverse proxy that sets X-Forwarded-For.
WEB_TRUST_PROXY=false

# --- Runtime --------------------------------------------------------------
TIMEZONE=Asia/Tashkent
ENVIRONMENT=local
# LOCAL TESTING ONLY: true lifts the share-page creation limits, the premium
# gate and the public pages' rate limits. Production refuses to start with it.
DEV_UNLIMITED_PAGES=false
LOG_LEVEL=INFO
# The product's name wherever a person reads it (bot texts, admin panel, pages).
# Undecided; the default is the working name. No < > & { }, at most 40 chars.
BRAND_NAME=Gulbot

# --- CP22 local speech (optional; text entry always works) -----------------
# Install .[stt] and ffmpeg, then choose an approved local model directory.
# Missing models never download automatically. Only the dedicated stt worker
# consumes speech jobs. Initial small-model plan: 1.5-2.5 GiB worker RAM.
STT_ENGINE=faster-whisper
STT_MODEL_PATH=
STT_CPU_THREADS=2
# Linux example. On Windows use an absolute directory under your actual TEMP;
# the production systemd unit uses /run/gulbot-stt (DEPLOY section 17).
STT_AUDIO_DIR=/tmp/gulbot-stt
STT_GEMINI_ENABLED=false
GEMINI_API_KEY=
STT_GEMINI_MODEL=

# --- CP23 Instagram story publishing (built, OFF by default) ----------------
# Needs a Meta app with Instagram content publishing approved; see
# docs/DEPLOY.md, "Instagram". Off, the bot gives the owner the story image
# to share by hand. The three URLs are overridden only by tests.
INSTAGRAM_PUBLISHING_ENABLED=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_URL=https://graph.instagram.com
INSTAGRAM_OAUTH_URL=https://api.instagram.com
INSTAGRAM_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_GRAPH_VERSION=v21.0
