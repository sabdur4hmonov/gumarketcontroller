.env
# Every env file, whatever it is called (pre-deployment audit, pass 6).
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Celery beat writes its schedule next to wherever it was started.
celerybeat-schedule*

# The staging rehearsal's env file, CA and transcript (deploy/rehearsal/rehearse.sh).
deploy/rehearsal/out/

# Temporary CP22 development staging; not shipped.
.cp22-stage/

# Isolated CP24 local tooling/logs.
.cp24-stage/
cp24-install.log

# Rebuilt on deploy from the tracked CSS/JS/SVG, never customer photos.
src/gulbot/web/static/**/*.br
src/gulbot/web/static/**/*.gz
