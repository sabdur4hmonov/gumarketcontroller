* text=auto eol=lf

# Must stay LF: real `make` chokes on CRLF recipe lines, and these run inside
# Linux containers.
Makefile        text eol=lf
*.sh            text eol=lf
*.yml           text eol=lf

# PowerShell is native Windows tooling.
*.ps1           text eol=crlf

# Vendored licensed data must retain the upstream bytes in its hash manifests.
src/gulbot/announcements/assets/dictionary/* -text -diff
src/gulbot/announcements/assets/fonts/* -text -diff
src/gulbot/announcements/assets/*/SOURCE.json text eol=lf diff
